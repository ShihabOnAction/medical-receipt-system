# ---------------------------------------------------------------------
# Backend environment - copy to .env and fill in.
# NEVER commit .env. The service-role key must stay on the server only.
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173

# Comma separated e-mail domains allowed to register
ALLOWED_EMAIL_DOMAINS=gmail.com

# Optional: point Puppeteer at a system Chrome instead of the bundled one
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

TZ_NAME=Asia/Dhaka
LOG_LEVEL=dev
